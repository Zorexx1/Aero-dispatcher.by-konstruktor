def log_event(msg):
    event_log.append({"time": datetime.now().strftime("%H:%M:%S"), "msg": msg})
    if len(event_log) > 100:
        event_log.pop(0)

def haversine(lat1, lon1, lat2, lon2):
    R = 6371.0
    dlat = math.radians(lat2 - lat1)
    dlon = math.radians(lon2 - lon1)
    a = math.sin(dlat/2)**2 + math.cos(math.radians(lat1)) * math.cos(math.radians(lat2)) * math.sin(dlon/2)**2
    return 2 * R * math.atan2(math.sqrt(a), math.sqrt(1 - a))

def find_truck_near(lat, lon):
    best, best_d = None, 1e9
    for pid in ("truck_n", "truck_s"):
        p = POINTS[pid]
        d = haversine(lat, lon, p["lat"], p["lon"])
        if d < best_d:
            best_d, best = d, pid
    return best, best_d

def calc_eta(emp_lat, emp_lon, target_lat, target_lon):
    dist = haversine(emp_lat, emp_lon, target_lat, target_lon)
    truck_pid, truck_dist = find_truck_near(emp_lat, emp_lon)
    walk_time = (dist / WALK_SPEED) * 60
    if truck_dist < 0.3:
        t_to_truck = (truck_dist / WALK_SPEED) * 60
        ride = haversine(POINTS[truck_pid]["lat"], POINTS[truck_pid]["lon"], target_lat, target_lon)
        t_ride = (ride / TRUCK_SPEED) * 60
        truck_time = t_to_truck + t_ride
        if truck_time < walk_time:
            return truck_time, dist, True, truck_pid
    return walk_time, dist, False, None

def find_candidates(stand_id, fault_type):
    target = POINTS[stand_id]
    qual = FAULT_TYPES[fault_type]["qual"]
    cands = []
    for eid, emp in employees.items():
        if qual not in emp["skills"]:
            continue
        if emp["status"] != "free":
            continue
        eta, dist, by_truck, truck_pid = calc_eta(emp["lat"], emp["lon"], target["lat"], target["lon"])
        if eta <= REGLEMENT_MIN:
            cands.append({
                "emp_id": eid, "name": emp["name"], "qual_name": emp["qual_name"],
                "eta_min": round(eta, 1), "distance_km": round(dist, 3),
                "by_truck": by_truck, "truck_point": truck_pid, "within_reglement": True,
            })
    cands.sort(key=lambda x: x["eta_min"])
    return cands

def get_stats():
    free = sum(1 for e in employees.values() if e["status"] == "free")
    busy = sum(1 for e in employees.values() if e["status"] == "busy")
    enroute = sum(1 for e in employees.values() if e["status"] == "enroute")
    return {"free": free, "busy": busy, "enroute": enroute, "total": len(employees)}

def emit_all_state():
    socketio.emit('state_update', {
        'employees': list(employees.values()),
        'points': POINTS,
        'requests': list(requests_db.values()),
        'assignments': list(assignments_db.values()),
        'stats': get_stats(),
        'events': event_log[-20:],
    })

def gps_tracking_loop():
    while True:
        socketio.sleep(0.5) 
        moved_any = False
        state_changed = False
        for eid, emp in employees.items():
            if emp["status"] == "enroute" and emp.get("target_lat") and emp.get("target_lon"):
                dlat = emp["target_lat"] - emp["lat"]
                dlon = emp["target_lon"] - emp["lon"]
                dist = math.hypot(dlat, dlon)
                step = 0.00035 
                
                if dist < step:
                    emp["lat"] = emp["target_lat"]
                    emp["lon"] = emp["target_lon"]
                    emp["target_lat"] = None
                    emp["target_lon"] = None
                    
                    has_active = any(a["employee_id"] == eid and a["status"] in ("assigned", "accepted") for a in assignments_db.values())
                    
                    if has_active:
                        emp["status"] = "busy"
                        log_event(f"Сотрудник {emp['name']} прибыл к ВС и начал работу.")
                        if emp["name"] != "Иванов И.И.":
                            emp["busy_until"] = time.time() + random.randint(10, 15)
                    else:
                        emp["status"] = "free"
                        log_event(f"Сотрудник {emp['name']} прибыл на базу.")
                    state_changed = True
                else:
                    emp["lat"] += (dlat/dist) * step
                    emp["lon"] += (dlon/dist) * step
                
                socketio.emit('employee_moved', {"id": eid, "lat": emp["lat"], "lon": emp["lon"], "status": emp["status"]})
                moved_any = True

            elif emp["status"] == "busy" and emp["name"] != "Иванов И.И.":
                if emp.get("busy_until") and time.time() > emp["busy_until"]:
                    for aid, a in assignments_db.items():
                        if a["employee_id"] == eid and a["status"] in ("assigned", "accepted"):
                            a["status"] = "completed"
                            if a["request_id"] in requests_db:
                                requests_db[a["request_id"]]["status"] = "completed"
                    
                    emp["status"] = "enroute"
                    emp["target_lat"] = POINTS["atb"]["lat"]
                    emp["target_lon"] = POINTS["atb"]["lon"]
                    emp["busy_until"] = None
                    log_event(f"NPC {emp['name']} завершил ремонт и уходит в АТБ.")
                    state_changed = True
                
        if state_changed:
            emit_all_state()
        elif moved_any:
            socketio.emit('state_update', {'stats': get_stats()})


