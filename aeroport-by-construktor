    data = request.json
    rid = str(uuid.uuid4())[:8]
    req = { "id": rid, "stand_id": data["stand_id"], "stand_name": POINTS[data["stand_id"]]["name"], "board_number": data.get("board_number", "RA-12345"), "fault_type": data["fault_type"], "fault_name": FAULT_TYPES[data["fault_type"]]["name"], "status": "open", "created_at": datetime.now().strftime("%H:%M:%S"), "candidates": find_candidates(data["stand_id"], data["fault_type"]) }
