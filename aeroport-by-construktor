@app.route('/api/assign', methods=['POST'])
def api_assign():
    data = request.json
    rid, eid = data["request_id"], data["employee_id"]
    req, emp = requests_db.get(rid), employees.get(eid)
    if not req or not emp: return jsonify({"error": "not found"}), 404
    cand = next((c for c in req["candidates"] if c["emp_id"] == eid), None)
    aid = str(uuid.uuid4())[:8]
    assignment = { "id": aid, "request_id": rid, "employee_id": eid, "employee_name": emp["name"], "stand_id": req["stand_id"], "stand_name": req["stand_name"], "board_number": req["board_number"], "fault_type": req["fault_type"], "fault_name": req["fault_name"], "eta_min": cand["eta_min"] if cand else 0, "by_truck": cand["by_truck"] if cand else False, "status": "assigned", "created_at": datetime.now().strftime("%H:%M:%S") }
    assignments_db[aid] = assignment

    if emp["name"] == "Иванов И.И.":
        emp["status"], req["status"] = "assigned", "assigned"
        log_event("Назначение: " + emp["name"] + " -> " + req["stand_name"] + " (Ожидание подтверждения)")
        socketio.emit('assignment_notification', {"employee_id": eid, "assignment": assignment})
    else:
        assignment["status"], emp["status"], req["status"] = "accepted", "enroute", "assigned"
        emp["target_lat"], emp["target_lon"] = POINTS[req["stand_id"]]["lat"], POINTS[req["stand_id"]]["lon"]
        log_event("Назначение: " + emp["name"] + " -> " + req["stand_name"] + " (Авто-выезд)")
        
    emit_all_state()
    return jsonify(assignment)

