def android_status():
    eid, new_status = request.json.get("employee_id"), request.json.get("status")
    if eid in employees:
        emp = employees[eid]
        if new_status == "return_to_base":
            for aid, a in list(assignments_db.items()):
                if a["employee_id"] == eid and a["status"] in ("assigned", "accepted"):
                    a["status"] = "completed"
                    if a["request_id"] in requests_db: requests_db[a["request_id"]]["status"] = "completed"
            emp["target_lat"], emp["target_lon"], emp["status"] = POINTS["atb"]["lat"], POINTS["atb"]["lon"], "enroute"
            log_event(emp["name"] + " успешно завершил работу на ВС и возвращается в АТБ.")
            emit_all_state()
            return jsonify({"status": "ok"})
        if new_status in ("free", "busy", "enroute"):
            old = emp["status"]
            emp["status"] = new_status
            log_event(emp["name"] + ": " + old + " -> " + new_status)
            emit_all_state()
            return jsonify({"status": "ok"})
    return jsonify({"error": "not found"}), 404

@app.route('/api/android/assignment_respond', methods=['POST'])
def android_respond():
    eid, aid, accepted = request.json.get("employee_id"), request.json.get("assignment_id"), request.json.get("accepted", True)
    if aid in assignments_db and assignments_db[aid]["employee_id"] == eid:
        if accepted:
            assignments_db[aid]["status"] = "accepted"
            log_event(employees[eid]["name"] + " принял назначение!")
            stand_id = assignments_db[aid]["stand_id"]
            employees[eid]["target_lat"], employees[eid]["target_lon"], employees[eid]["status"] = POINTS[stand_id]["lat"], POINTS[stand_id]["lon"], "enroute"
        else:
            assignments_db[aid]["status"] = "rejected"
            employees[eid]["status"], employees[eid]["target_lat"], employees[eid]["target_lon"] = "free", None, None
            log_event(employees[eid]["name"] + " отклонил назначение!")
        emit_all_state()
        return jsonify({"status": "ok"})
    return jsonify({"error": "not found"}), 404

