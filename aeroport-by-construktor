@app.route('/api/test/<int:scenario>')
def api_test(scenario):
    if scenario == 1:
        for emp in employees.values(): emp["target_lat"], emp["target_lon"], emp["status"] = POINTS["atb"]["lat"], POINTS["atb"]["lon"], "enroute"
    elif scenario == 2:
        pts = [k for k in POINTS.keys() if not k.startswith("stand")]
        for emp in employees.values():
            pt = POINTS[random.choice(pts)]
            emp["target_lat"], emp["target_lon"], emp["status"] = pt["lat"], pt["lon"], "enroute"
    elif scenario == 3:
        for emp in employees.values(): emp["status"] = "busy"
    elif scenario == 4:
        for emp in employees.values(): emp["target_lat"], emp["target_lon"], emp["status"] = POINTS["truck_n"]["lat"], POINTS["truck_n"]["lon"], "enroute"
    elif scenario == 6:
        for emp in employees.values(): emp["status"], emp["target_lat"], emp["target_lon"] = "free", None, None
    elif scenario == 7:
        requests_db.clear(); assignments_db.clear()
        for emp in employees.values():
            if emp["name"] != "Иванов И.И.": emp["status"], emp["target_lat"], emp["target_lon"], emp["busy_until"] = "free", None, None, None
        log_event("Сброс всех заявок и статусов.")
    emit_all_state()
    return jsonify({"status": "ok"})

